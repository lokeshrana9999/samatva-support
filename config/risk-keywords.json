    { "id": "el-hi-gayab", "lang": "hi", "tier": "elevated", "pattern": "\\bgayab ho jaana chah(?:ta|ti)\\b" },
    { "id": "bh-hits-me", "lang": "en", "tier": "elevated", "beingHarmed": true, "pattern": "\\b(?:he|she|they|my (?:husband|wife|partner|father|dad|mother|mom|brother|boyfriend|girlfriend)) (?:hits|beats|slaps|chokes|threatens|hurts) me\\b" },
    { "id": "bh-not-safe", "lang": "en", "tier": "elevated", "beingHarmed": true, "pattern": "\\bnot safe (?:at home|here|with him|with her)\\b|\\bafraid (?:to go|of going) home\\b" },
    { "id": "bh-hi-maarta", "lang": "hi", "tier": "elevated", "beingHarmed": true, "pattern": "\\bmujhe (?:maarta|maarti|maarte|peet(?:ta|ti|te)) (?:hai|hain)\\b|\\bghar (?:mein|me) safe nahi\\b" }
